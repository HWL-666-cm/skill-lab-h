        {"key": "chen_publisher", "authors": "Chen H, Xu Y", "title": "Visibility forecast in Jiangsu", "year": 2024, "venue": "Scientific Reports", "volume": "14", "pages": "12599", "doi": "10.1038/s41598-024-61572-8", "type": "article-journal", "order": 1},
        {"key": "chen_crossref", "authors": "Chen H, Xu Y", "title": "Visibility forecast in Jiangsu", "year": 2024, "doi": "10.1038/s41598-024-61572-8", "type": "article-journal", "order": 2}
      ],
      "expect_types": ["duplicate_same_doi"],
      "expect_absent": ["duplicate_conflict"],
      "expect_verdict": "review_warnings"
    },
    {
      "id": "T5",
      "name": "同 DOI 但题名冲突：禁止自动合并",
