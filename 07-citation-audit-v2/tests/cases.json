{
  "description": "07 引用审计自测用例：每条都是合成数据，不含任何论文原文。",
  "cases": [
    {
      "id": "T1",
      "name": "悬空引用：正文 [7] 不在文献库",
      "manuscript": "海雾预报的研究进展见文献[1]，另有工作[7]提出不同结论。\n\n参考文献\n[1] A. 作者. 题名一. 期刊, 2020.\n[2] B. 作者. 题名二. 期刊, 2021.",
      "bib": [
        {"key": "a2020", "authors": "Alpha A", "title": "Title One", "year": 2020, "order": 1},
        {"key": "b2021", "authors": "Beta B", "title": "Title Two", "year": 2021, "order": 2}
      ],
      "expect_types": ["dangling_citation"],
      "expect_absent": [],
      "expect_verdict": "needs_revision"
    },
    {
      "id": "T2",
      "name": "未用条目：库中文献 [2] 正文未引（警告不阻断）",
      "manuscript": "只引用了第一条[1]，其余内容不涉及外部来源。",
      "bib": [
        {"key": "a2020", "authors": "Alpha A", "title": "Title One", "year": 2020, "order": 1},
        {"key": "b2021", "authors": "Beta B", "title": "Title Two", "year": 2021, "order": 2}
      ],
      "expect_types": ["unused_entry"],
      "expect_absent": ["dangling_citation"],
      "expect_verdict": "review_warnings"
    },
    {
      "id": "T3",
      "name": "编号乱序与跳号：正文先 [3] 后 [1]，缺 [2]",
      "manuscript": "先说第三项[3]，再说第一项[1]。",
      "bib": [
        {"key": "a2020", "authors": "Alpha A", "title": "Title One", "year": 2020, "order": 1},
        {"key": "b2021", "authors": "Beta B", "title": "Title Two", "year": 2021, "order": 2},
        {"key": "c2022", "authors": "Gamma C", "title": "Title Three", "year": 2022, "order": 3}
      ],
      "expect_types": ["numbering_gap", "first_appearance_order", "unused_entry"],
      "expect_absent": [],
      "expect_verdict": "needs_revision"
    },
    {
      "id": "T4",
      "name": "同 DOI 重复：应给合并建议并记录判据",
