{
  "version": "1.0",
  "note": "诊断词表。所有词条只产生信号与追问，不自动删除或改写正文——语义判断留给人。",

  "citation_patterns": [
    {"name": "tex_cite", "regex": "\\\\cite[a-zA-Z]*\\s*\\{([^}]+)\\}", "group": 1, "kind": "bibkey"},
    {"name": "numeric_bracket", "regex": "\\[(\\d{1,3}(?:[,\\s\\-–]\\d{1,3})*)\\]", "group": 1, "kind": "number"},
    {"name": "author_year_paren", "regex": "\\(([A-Z][A-Za-z\\-']+(?:\\s+et\\s+al\\.?)?)\\s*[,;]?\\s*(19|20)\\d{2}[a-z]?\\)", "group": 0, "kind": "author_year"},
    {"name": "author_year_text", "regex": "([A-Z][A-Za-z\\-']+(?:\\s+et\\s+al\\.?)?)\\s*\\((19|20)\\d{2}[a-z]?\\)", "group": 0, "kind": "author_year"},
    {"name": "chinese_ref", "regex": "([\\u4e00-\\u9fff]{2,8})(?:等)?[，,]\\s*((?:19|20)\\d{2})", "group": 0, "kind": "author_year"},
    {"name": "fullwidth_author_year", "regex": "[（(]([A-Z][A-Za-z\\-']+(?:\\s+et\\s+al\\.?)?\\s*,?\\s*)?(19|20)\\d{2}[a-z]?[）)]", "group": 0, "kind": "author_year"},
    {"name": "concat_author_year", "regex": "([A-Z][A-Za-z\\-']{2,}(?:(?:and|et)[A-Za-z\\.\\s]*)?)\\s*((?:19|20)\\d{2})", "group": 0, "kind": "author_year"}
  ],

  "figure_patterns": [
    {"name": "fig", "regex": "(?:Fig(?:ure)?\\.?|图)\\s*(\\d+[a-z]?)", "kind": "figure"},
    {"name": "table", "regex": "(?:Tab(?:le)?\\.?|表)\\s*(\\d+[a-z]?)", "kind": "table"},
    {"name": "section", "regex": "(?:Sec(?:tion)?\\.?|§|第)\\s*(\\d+(?:\\.\\d+)*)\\s*(?:节|章)?", "kind": "section"},
    {"name": "eq", "regex": "(?:Eq(?:uation)?\\.?|式)\\s*\\(?(\\d+)\\)?", "kind": "equation"}
  ],

  "bib_author_year": {
    "year_in_line": "\\b((?:19|20)\\d{2})\\b",
    "author_lead": "^\\s*([A-Z][A-Za-z\\-']+(?:\\s+et\\s+al\\.?)?)",
    "title_after_year": "(?:\\d{4})[\\.\\,\\s]+[\\\"“]?([^\\\"”\\n]{8,200})"
  },

  "hedge_terms": [
    "may", "might", "could", "suggest", "suggests", "indicate", "indicates",
    "appear", "appears", "likely", "possible", "possibly", "tend to", "tends to",
    "部分", "可能", "似乎", "倾向于", "提示", "表明", "一定程度", "在本文条件下"
  ],

  "overclaim_terms": [
    "prove", "proves", "proven", "definitively", "unambiguously", "always", "never",
    "首次", "开创性", "填补国内外空白", "国际领先", "完全解决", "彻底解决",
    "显著提升", "大幅提高", "必然", "毫无疑问", "唯一"
  ],

  "cliche_terms": [
    "近年来受到广泛关注", "随着.{0,12}的快速发展", "具有重要意义",
    "日益受到重视", "成为一个热门话题", "现有研究仍存在不足",
    "研究还不够充分", "有待进一步研究", "不仅...而且",
    "with the development of", "has attracted wide attention",
    "has become a hot topic", "is of great significance",
    "there is still a lack of", "remains an open challenge"
  ],

  "gap_signals": [
    "however", "nevertheless", "limitation", "limited", "unexplored", "lack", "remain",
    "however,", "but", "未能", "尚未", "缺乏", "局限", "不足", "未覆盖",
    "没有考虑", "不适用于", "难以", "仍存在"
  ],

  "contribution_signals": [
    "we propose", "we present", "we introduce", "our contributions", "in this paper we",
    "本文提出", "本文主要贡献", "本研究", "本文工作", "我们的贡献", "具体而言"
  ],

  "related_work_headings": [
    "related work", "literature review", "prior work", "background",
    "相关工作", "文献综述", "研究现状", "已有研究", "国内外研究"
  ],

  "group_dimensions": [
    "问题设定", "方法路线", "技术路线", "数据与评价", "评价方式", "适用场景",
    "按问题", "按方法", "按数据", "按路线",
    "problem setting", "method", "approach", "data", "evaluation", "benchmark",
    "task", "setting", "category", "taxonomy"
  ],

  "section_names": {
    "background": ["研究背景", "背景", "introduction", "背景与意义"],
    "related_work": ["相关工作", "文献综述", "研究现状", "related work", "prior work"],
    "gap": ["研究空白", "问题陈述", "研究问题", "gap", "research gap", "问题定义"],
    "contribution": ["贡献", "本文贡献", "主要贡献", "contributions"]
  }
}
