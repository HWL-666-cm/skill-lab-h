{
  "note": "合成用例：每个 case 给出原文段落、术语表、译文，断言审计结果。不是平台案例，只用于证明脚本能抓错。",
  "cases": [
    {
      "id": "T1",
      "name": "干净译文：段号齐全、术语一致、数字单位引用都保留 → ok",
      "paras": [
        {"pid": 1, "page": 1, "section": "1 Introduction", "kind": "para",
         "text": "Low-visibility procedure (lvp) states reduce airport capacity. The lvp states occur at 06:00 UTC."},
        {"pid": 2, "page": 1, "section": "1 Introduction", "kind": "para",
         "text": "We use boosting trees and compare them with ordered logistic regression (OLR) models."}
      ],
      "concepts": [
        {"concept_id": "C01", "source": "low-visibility procedure", "abbr": "lvp", "target": "低能见度程序", "aliases_allowed": ["LVP"], "forbidden": ["低可见度程序"]},
        {"concept_id": "C02", "source": "boosting trees", "abbr": "", "target": "提升树", "aliases_allowed": [], "forbidden": ["助推树"]},
        {"concept_id": "C03", "source": "ordered logistic regression", "abbr": "OLR", "target": "有序逻辑回归", "aliases_allowed": [], "forbidden": []}
      ],
      "translation": {
        "1": "低能见度程序（LVP）状态会降低机场容量。这些 LVP 状态出现在 06:00 UTC。",
        "2": "我们使用提升树，并与有序逻辑回归（OLR）模型比较。"
      },
      "expect_absent": ["missing_paragraph", "term_missing_in_translation", "number_lost", "unit_lost"],
      "expect_verdict": "ok"
    },
    {
      "id": "T2",
      "name": "漏段：pid 2 没译 → missing_paragraph（硬错误）",
      "paras": [
        {"pid": 1, "kind": "para", "page": 1, "section": "1 Introduction", "text": "Visibility is low at 06:00 UTC."},
        {"pid": 2, "kind": "para", "page": 1, "section": "1 Introduction", "text": "We use boosting trees."}
      ],
      "concepts": [],
      "translation": {"1": "06:00 UTC 能见度较低。"},
      "expect_present": ["missing_paragraph"],
      "expect_verdict": "needs_revision"
    },
    {
      "id": "T3",
      "name": "术语漂移：该用「低能见度程序」却写成「低可见度程序」→ term_missing",
      "paras": [
        {"pid": 1, "kind": "para", "page": 1, "section": "1 Introduction",
         "text": "The low-visibility procedure (lvp) states are graded."}
      ],
      "concepts": [
        {"concept_id": "C01", "source": "low-visibility procedure", "abbr": "lvp", "target": "低能见度程序", "aliases_allowed": ["LVP"], "forbidden": ["低可见度程序"]}
      ],
      "translation": {"1": "这些低可见度程序状态是分级的。"},
      "expect_present": ["term_missing_in_translation"],
      "expect_verdict": "needs_revision"
    },
    {
      "id": "T4",
      "name": "禁用别名：术语表禁「助推树」，译文偏用了 → forbidden_term_used",
      "paras": [
        {"pid": 1, "kind": "para", "page": 1, "section": "2 Data", "text": "Boosting trees consist of decision trees."}
      ],
      "concepts": [
        {"concept_id": "C02", "source": "boosting trees", "abbr": "", "target": "提升树", "aliases_allowed": [], "forbidden": ["助推树"]}
      ],
      "translation": {"1": "助推树由决策树组成。"},
      "expect_present": ["term_missing_in_translation", "forbidden_term_used"],
      "expect_verdict": "needs_revision"
    },
    {
      "id": "T5",
      "name": "数字丢失：原文 1177 与 0.1，译文只剩 1177 → number_lost",
      "paras": [
        {"pid": 1, "kind": "para", "page": 2, "section": "2 Data",
         "text": "There are 1177 observations with a resolution of 0.1 degrees."}
      ],
      "concepts": [],
      "translation": {"1": "共有 1177 个观测，分辨率为零点一度。"},
      "expect_present": ["number_lost"],
      "expect_verdict": "needs_revision"
    },
    {
      "id": "T6",
      "name": "单位丢失：原文 9 km，译文只写「9」→ unit_lost（警告）",
      "paras": [
        {"pid": 1, "kind": "para", "page": 2, "section": "2 Data",
         "text": "The grid boxes are about 9 km."}
      ],
      "concepts": [],
      "translation": {"1": "网格约为 9。"},
      "expect_present": ["unit_lost"],
      "expect_verdict": "needs_review"
    },
    {
      "id": "T7",
      "name": "否定丢失：原文 not observed，译文无否定词 → negation_lost（警告）",
      "paras": [
        {"pid": 1, "kind": "para", "page": 3, "section": "3 Results",
         "text": "This effect was not observed at longer lead times."}
      ],
      "concepts": [],
      "translation": {"1": "该效应在较长预报时效下被观测到。"},
      "expect_present": ["negation_lost"],
      "expect_verdict": "needs_review"
    },
    {
      "id": "T8",
      "name": "引用年份丢失：原文 (Dietz et al., 2019)，译文没写年份 → cite_year_lost（警告）",
      "paras": [
        {"pid": 1, "kind": "para", "page": 1, "section": "1 Introduction",
         "text": "Boosting trees performed best at short lead times (Dietz et al., 2019)."}
      ],
      "concepts": [],
      "translation": {"1": "提升树在短预报时效下表现最好（Dietz 等）。"},
      "expect_present": ["cite_year_lost"],
      "expect_verdict": "needs_review"
    },
    {
      "id": "T9",
      "name": "错号/多译：译文出现原文没有的 pid 99 → orphan_paragraph",
      "paras": [
        {"pid": 1, "kind": "para", "page": 1, "section": "1 Introduction", "text": "Visibility is low."}
      ],
      "concepts": [],
      "translation": {"1": "能见度较低。", "99": "这是多余的一段。"},
      "expect_present": ["orphan_paragraph"],
      "expect_verdict": "needs_revision"
    },
    {
      "id": "T10",
      "name": "空译文：pid 1 给了但内容为空 → empty_translation",
      "paras": [
        {"pid": 1, "kind": "para", "page": 1, "section": "1 Introduction", "text": "Visibility is low."}
      ],
      "concepts": [],
      "translation": {"1": "   "},
      "expect_present": ["empty_translation"],
      "expect_verdict": "needs_revision"
    },
    {
      "id": "T11",
      "name": "非正文段不算漏段：meta/formula/fragment 不要求译文（防误报）",
      "paras": [
        {"pid": 1, "kind": "meta", "page": 1, "section": "", "text": "Adv. Stat. Clim. Meteorol. Oceanogr., 5, 101-114"},
        {"pid": 2, "kind": "para", "page": 1, "section": "1 Introduction", "text": "Visibility is low at 06:00 UTC."},
        {"pid": 3, "kind": "formula", "page": 1, "section": "1 Introduction", "text": "P(x) = 1/(1+exp(-x))"},
        {"pid": 4, "kind": "reference", "page": 9, "section": "References", "text": "Agresti, A.: Categorical Data Analysis, 2003."}
      ],
      "concepts": [],
      "translation": {"2": "06:00 UTC 能见度较低。"},
      "expect_absent": ["missing_paragraph"],
      "expect_verdict": "ok"
    },
    {
      "id": "T12",
      "name": "全角数字与半角等价：原文全角「１０」，译文半角「10」不算丢（防误报）",
      "paras": [
        {"pid": 1, "kind": "para", "page": 5, "section": "4 Discussion", "text": "The limit is reached at １０ d."}
      ],
      "concepts": [],
      "translation": {"1": "该上限在 10 d 达到。"},
      "expect_absent": ["number_lost"],
      "expect_verdict": "ok"
    },
    {
      "id": "T13",
      "name": "术语表未定译名：target 为空 → glossary_unlocked（警告），不误判漂移",
      "paras": [
        {"pid": 1, "kind": "para", "page": 1, "section": "1 Introduction", "text": "The dew point depression matters."}
      ],
      "concepts": [
        {"concept_id": "C05", "source": "dew point depression", "abbr": "", "target": "", "aliases_allowed": [], "forbidden": []}
      ],
      "translation": {"1": "露点差很重要。"},
      "expect_present": ["glossary_unlocked"],
      "expect_absent": ["term_missing_in_translation"],
      "expect_verdict": "needs_review"
    }
  ]
}
