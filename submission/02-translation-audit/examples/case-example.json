{
  "note": "最小调用示例，演示输入形态，不是平台案例、不是正式结果。",
  "input": {
    "case_id": "example-001",
    "source": "example.pdf",
    "target_language": "zh",
    "scope": "Abstract only"
  },
  "step_1_paragraphs": {
    "command": "python3 scripts/pdf_paragraphs.py --pdf example.pdf --out /app/work/paras.json",
    "output_excerpt": {
      "paragraphs": [
        {"pid": 1, "page": 1, "section": "", "kind": "meta", "text": "Example Journal, 5, 101-114, 2024"},
        {"pid": 2, "page": 1, "section": "", "kind": "heading", "text": "1 Introduction"},
        {"pid": 3, "page": 1, "section": "1 Introduction", "kind": "para",
         "text": "Visibility forecasts are generated with two approaches (Author et al., 2020)."}
      ]
    }
  },
  "step_2_glossary": {
    "command": "python3 scripts/term_extract.py --paras /app/work/paras.json --out /app/work/glossary.json",
    "after_agent_review": {
      "concepts": [
        {"concept_id": "C01", "source": "visibility forecast", "abbr": "", "target": "能见度预报",
         "aliases_allowed": ["visibility forecasts"], "forbidden": ["可见度预报"],
         "occurrences": [{"pid": 3, "page": 1, "section": "1 Introduction"}], "locked": true}
      ]
    }
  },
  "step_3_translation": {
    "format": "json or markdown",
    "example": {"paragraphs": [{"pid": 3, "target": "能见度预报由两种方法生成（Author et al., 2020）。"}]}
  },
  "step_4_audit": {
    "command": "python3 scripts/translation_audit.py --paras /app/work/paras.json --glossary /app/work/glossary.json --translation /app/work/translation.json --scope 3 --out /app/work/audit.json",
    "expected_verdict": "ok"
  },
  "step_5_result": {
    "command": "python3 scripts/make_result.py --case-id example-001 --paras /app/work/paras.json --glossary /app/work/glossary.json --translation /app/work/translation.json --audit /app/work/audit.json --out /app/output/result.json",
    "artifacts": ["result.json", "bilingual.md", "glossary.csv"]
  }
}
